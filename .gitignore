# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

/lib/generated/prisma

# uploaded images (dev-only local storage, see /api/upload)
/public/uploads/*
!/public/uploads/.gitkeep

# Prisma
prisma/migrations/**/migration_lock.toml

# Editor / IDE
.vscode/
.idea/

# OS files
Thumbs.db

# Logs
logs/
*.log

# Uploaded files (if storing locally during dev)
/uploads/
/public/uploads/